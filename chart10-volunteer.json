{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Culture also depends on unpaid contribution",
    "subtitle": "Among Australians participating in selected cultural activities, 2021–22. Measures have different bases; see labels."
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "domain": false,
      "tickSize": 0,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#e8e5df"
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "title": {
      "font": "Bricolage Grotesque",
      "fontSize": 18,
      "anchor": "start",
      "subtitleFont": "Source Sans 3",
      "subtitleColor": "#59645e",
      "subtitleFontSize": 13
    }
  },
  "width": 600,
  "height": 240,
  "data": {
    "url": "cultural_volunteering.json"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#c8d0ca",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "activity",
          "type": "nominal",
          "title": null
        },
        "x": {
          "datum": 0,
          "type": "quantitative"
        },
        "x2": {
          "field": "rate",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 140,
        "color": "#167c72"
      },
      "encoding": {
        "y": {
          "field": "activity",
          "type": "nominal",
          "title": null
        },
        "x": {
          "field": "rate",
          "type": "quantitative",
          "title": "Share (%)"
        },
        "tooltip": [
          {
            "field": "activity",
            "type": "nominal"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Share (%)"
          }
        ]
      }
    }
  ]
}
