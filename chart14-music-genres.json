{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Festival diversity is audible in the genre mix",
    "subtitle": "Share of mapped Australian music festivals listing each genre, 2022–23. Festivals can list more than one genre, so percentages do not sum to 100."
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "domain": false,
      "tickSize": 0,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#e8e5df"
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "title": {
      "font": "Bricolage Grotesque",
      "fontSize": 18,
      "anchor": "start",
      "subtitleFont": "Source Sans 3",
      "subtitleColor": "#59645e",
      "subtitleFontSize": 13
    }
  },
  "width": 600,
  "height": 350,
  "data": {
    "url": "music_genres.json"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4,
    "color": "#167c72"
  },
  "encoding": {
    "y": {
      "field": "genre",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "share",
      "type": "quantitative",
      "title": "Share of festivals listing genre (%)",
      "scale": {
        "domain": [
          0,
          25
        ]
      }
    },
    "tooltip": [
      {
        "field": "genre",
        "type": "nominal"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Share (%)"
      }
    ]
  }
}
